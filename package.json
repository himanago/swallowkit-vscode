{
  "name": "swallowkit-vscode",
  "displayName": "SwallowKit",
  "description": "VS Code extension for SwallowKit - Next.js + Azure Functions + Cosmos DB toolkit with Zod schema sharing",
  "version": "0.4.0",
  "publisher": "himanago",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "azure",
    "next.js",
    "azure functions",
    "cosmos db",
    "zod",
    "scaffold",
    "crud"
  ],
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/himanago/swallowkit-vscode"
  },
  "homepage": "https://himanago.github.io/swallowkit/",
  "bugs": {
    "url": "https://github.com/himanago/swallowkit-vscode/issues"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:**/shared/models/*.ts",
    "workspaceContains:**/swallowkit.config.*",
    "workspaceContains:**/functions/host.json",
    "workspaceContains:**/.swallowkit/*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "swallowkit.init",
        "title": "%swallowkit.init.title%"
      },
      {
        "command": "swallowkit.createModel",
        "title": "%swallowkit.createModel.title%"
      },
      {
        "command": "swallowkit.createDevSeeds",
        "title": "%swallowkit.createDevSeeds.title%"
      },
      {
        "command": "swallowkit.scaffold",
        "title": "%swallowkit.scaffold.title%"
      },
      {
        "command": "swallowkit.scaffoldApiOnly",
        "title": "%swallowkit.scaffoldApiOnly.title%"
      },
      {
        "command": "swallowkit.scaffoldDryRun",
        "title": "%swallowkit.scaffoldDryRun.title%"
      },
      {
        "command": "swallowkit.startDev",
        "title": "%swallowkit.startDev.title%"
      },
      {
        "command": "swallowkit.stopDev",
        "title": "%swallowkit.stopDev.title%"
      },
      {
        "command": "swallowkit.provision",
        "title": "%swallowkit.provision.title%"
      },
      {
        "command": "swallowkit.addAuth",
        "title": "%swallowkit.addAuth.title%"
      },
      {
        "command": "swallowkit.addConnector",
        "title": "%swallowkit.addConnector.title%"
      },
      {
        "command": "swallowkit.status",
        "title": "%swallowkit.status.title%"
      },
      {
        "command": "swallowkit.verify",
        "title": "%swallowkit.verify.title%"
      },
      {
        "command": "swallowkit.openDocs",
        "title": "%swallowkit.openDocs.title%"
      },
      {
        "command": "swallowkit.toggleDev",
        "title": "%swallowkit.toggleDev.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "swallowkit.toggleDev",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "swallowkit.scaffold",
          "when": "resourcePath =~ /(?:shared|lib)[/\\\\]models[/\\\\].*\\.ts$/",
          "group": "swallowkit@1"
        },
        {
          "command": "swallowkit.scaffoldApiOnly",
          "when": "resourcePath =~ /(?:shared|lib)[/\\\\]models[/\\\\].*\\.ts$/",
          "group": "swallowkit@2"
        },
        {
          "command": "swallowkit.scaffoldDryRun",
          "when": "resourcePath =~ /(?:shared|lib)[/\\\\]models[/\\\\].*\\.ts$/",
          "group": "swallowkit@3"
        },
        {
          "command": "swallowkit.createModel",
          "when": "explorerResourceIsFolder && resourcePath =~ /(?:shared|lib)[/\\\\]models/",
          "group": "swallowkit@1"
        }
      ],
      "editor/context": [
        {
          "command": "swallowkit.scaffold",
          "when": "resourcePath =~ /(?:shared|lib)[/\\\\]models[/\\\\].*\\.ts$/",
          "group": "swallowkit@1"
        }
      ],
      "editor/title": [
        {
          "command": "swallowkit.scaffold",
          "when": "resourcePath =~ /(?:shared|lib)[/\\\\]models[/\\\\].*\\.ts$/",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/swallowkit.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
